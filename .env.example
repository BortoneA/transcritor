# Configurações do Servidor
API_BACKEND_PORT=5000
API_BACKEND_HOST=127.0.0.1
API_PAYLOAD_MAX_SIZE=50mb

# Chave do Google Gemini (para transcrição direta ultrarrápida e geração de prontuário clínico)
GEMINI_API_KEY=

# Chaves do AssemblyAI (para transcrição de voz com diarização de falantes; separe múltiplas chaves por vírgula para fallback automático)
ASSEMBLY_API_KEYS=

# Chave do OpenRouter (opcional: caso queira usar modelos como NVIDIA Nemotron)
OPENROUTER_API_KEY=

# Opcional: Apenas se for usar Google Cloud / Vertex AI nativo
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# PROXY_HEADER=
